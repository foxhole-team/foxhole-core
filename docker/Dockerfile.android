FROM rust:1.97.1-bookworm@sha256:0e2bcaef56d041a486784e54104a81aebe0da44bd03019bd70bc0401e42e4a97

RUN apt-get update && apt-get install -y --no-install-recommends \
    clang cmake pkg-config libssl-dev python3 ripgrep unzip autoconf automake libtool \
    && rm -rf /var/lib/apt/lists/*

RUN curl --fail --location --retry 4 --retry-all-errors --no-progress-meter \
        https://dl.google.com/android/repository/android-ndk-r29-linux.zip \
        --output /tmp/ndk.zip \
    && echo '87e2bb7e9be5d6a1c6cdf5ec40dd4e0c6d07c30b  /tmp/ndk.zip' | sha1sum --check - \
    && unzip -q /tmp/ndk.zip -d /opt \
    && rm /tmp/ndk.zip \
    && test "$(sed -n 's/^Pkg.Revision *= *//p' /opt/android-ndk-r29/source.properties)" = 29.0.14206865

RUN rustup target add aarch64-linux-android armv7-linux-androideabi i686-linux-android x86_64-linux-android \
    && cargo install cargo-ndk --version 4.1.2 --locked

ENV ANDROID_NDK_HOME=/opt/android-ndk-r29 \
    ANDROID_NDK_ROOT=/opt/android-ndk-r29 \
    CARGO_NDK_PLATFORM=26 \
    CARGO_HOME=/cargo-cache \
    CARGO_TARGET_DIR=/build \
    CARGO_BUILD_JOBS=2 \
    CARGO_INCREMENTAL=0

WORKDIR /work
USER 1000:1000
